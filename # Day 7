seen  = set()

with open ("employees.csv","r",newline="") as file:
    reader  = csv.reader(file)

    for employees in reader :
        try :
            name = employees[0].strip()
            salary_text = employees[1]
            post = employees[2].strip()
            location = employees[3].strip()


            if salary_text == "":
                print(repr("Missing Salary",employees))
                continue

            salary = float(salary_text)

            if salary <= 0 :
                print("valid Saalry",employees)
                continue

            records = (name,salary,post,location)

            if records in seen:
                print("Dublicate Records:",records)
                continue

            seen.add(records)
            print("valid Recodrs:",records)

        except (ValueError ,IndexError) : 
