import csv

seen = set()
duplicate_count = 0

with open("employees.csv", "r", newline="") as file:
    reader = csv.reader(file)

    for employee in reader:
        try:
            name = employee[0].strip()
            salary = float(employee[1])
            post = employee[2].strip()
            location = employee[3].strip()

            record = (name, salary, post, location)

            if record in seen:
                duplicate_count += 1
                print("Duplicate:", record)
            else:
                seen.add(record)

        except (ValueError, IndexError):
            print("Invalid row:", employee)

print("Total duplicate occurrences:", duplicate_count)

