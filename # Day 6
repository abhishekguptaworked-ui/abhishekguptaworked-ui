import csv
salary_text = "Text Etc"
with open ("employees.csv","r",newline="") as file:
     reader  =  csv.reader(file)


     for emoloyees in reader:
        try:
            name = emoloyees[0].strip().lower()
            salary = float(emoloyees[1])
            post = emoloyees[2].strip().lower()
            location = emoloyees[3].strip().lower()
            print(name,salary,post,location)

        except ValueError :
            print("invalid valeu",salary_text)
