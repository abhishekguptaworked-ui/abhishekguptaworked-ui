import csv


with open ("employees.csv","r",newline="") as file:
    reader = csv.reader(file)

    for employees in reader:
        try:
            Name  = employees[0].strip().lower()
            Salary = float(employees[1])
            post = employees[2].strip().lower()
            location = employees[3].strip().lower()

            if Salary  =="":
                print("Missing Value",Name)
                continue
            salary  = float(employees[1])


            print(Name,salary,post,location)
        except ValueError :
         print("Salary Invalid Type",employees)
        
